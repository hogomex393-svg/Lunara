# Copy to .env and fill in your values

# OpenRouter API key — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx

# Default LLM model. Use a function-calling capable model for full Agent mode.
# Free options without function calling: meta-llama/llama-3.1-8b-instruct:free
# With function calling: meta-llama/llama-3.3-70b-instruct, openai/gpt-4o-mini, anthropic/claude-3.5-haiku
LLM_MODEL=meta-llama/llama-3.3-70b-instruct

# Server config
PORT=3001
NODE_ENV=development

# Admin panel password (simple bearer auth)
ADMIN_PASSWORD=lunara-admin-2026

# SQLite database path (relative to server/)
DB_PATH=./db/lunara.db

# Log file (relative to server/)
LOG_FILE=./logs/llm-calls.jsonl
